# Copy into an ignored .env.production on the destination; never commit real values.
APP_ENV=production
PUBLIC_BASE_URL=https://postenza.app
SEARCH_INDEXING_ENABLED=true
FLASK_SECRET_KEY=
DATABASE_URL=
POSTGRES_PASSWORD=
POSTENZA_DATA_DIR=/app/data
POSTENZA_EMBEDDED_SCHEDULER=false
# Enable only behind one trusted reverse proxy, with the app port private.
TRUST_PROXY_HEADERS=true
VERIFY_TOKEN=
META_APP_SECRET=
INSTAGRAM_OAUTH_APP_ID=
INSTAGRAM_OAUTH_REDIRECT_URI=https://postenza.app/connect/instagram/callback
# Preserve the production key ID and ALL retained keys when migrating.
INSTAGRAM_CREDENTIAL_ACTIVE_KEY_ID=
INSTAGRAM_CREDENTIAL_KEY_PRIMARY=
LEGACY_INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# disabled -> test once sandbox credentials and products are configured.
BILLING_MODE=disabled
BILLING_LIVE_APPROVED=false
LEMON_API_KEY=
LEMON_STORE_ID=
LEMON_WEBHOOK_SECRET=
LEMON_PRO_MONTHLY_VARIANT_ID=
LEMON_PRO_ANNUAL_VARIANT_ID=
LEMON_AGENCY_MONTHLY_VARIANT_ID=
LEMON_AGENCY_ANNUAL_VARIANT_ID=
# One-time credit packs ($5=500, $10=1200, $19=2500 credits). Create each
# variant by hand in Lemon Squeezy as a one-time (non-subscription)
# product variant; credit checkout stays disabled until they are set.
LEMON_CREDITS_500_VARIANT_ID=
LEMON_CREDITS_1200_VARIANT_ID=
LEMON_CREDITS_2500_VARIANT_ID=
# Operational allowances only; commercial plan prices are managed at the provider.
BILLING_PLANS_JSON={}
# Destination-only deployment settings:
POSTENZA_HOST=staging.example.com
ACME_EMAIL=
POSTENZA_IMAGE=postenza:local
