# Root-owned /etc/postenza-operations.env, mode 0600. Public recipient only.
# Keep the age private identity on independent protected recovery storage.
POSTENZA_BACKUP_RECIPIENT=
# Default 2 GiB per generated file; verify sizes/capacity before changing.
POSTENZA_BACKUP_MAX_FILE_BYTES=2147483648
# Enable these only after worker approval and a successful first backup.
POSTENZA_MONITOR_WORKER=false
POSTENZA_MONITOR_BACKUPS=false
